# Android / Expo Mobile Environment Variables
# Base URL for Express backend API requests.
#
# Defaults automatically resolved if unset:
# - Android Emulator: http://10.0.2.2:3000/api
# - Expo Web / iOS Simulator: http://localhost:3000/api
# - Physical Mobile Device: http://<YOUR_COMPUTER_LAN_IP>:3000/api
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
