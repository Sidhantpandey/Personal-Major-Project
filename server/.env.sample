PORT=3000
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=1h
BCRYPT_ROUNDS=12

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Python ML inference service
ML_SERVICE_URL=http://localhost:8000/api/v1/predict

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI / GPT Recommendations
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# CORS config (comma-separated origins for Web client, Expo Web, etc.)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081,http://127.0.0.1:5173