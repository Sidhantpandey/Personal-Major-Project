# Treat ML model weights as binary — prevents git from corrupting them via text encoding or line ending conversions
*.pth binary -text
*.pt binary -text
*.onnx binary -text
*.pkl binary -text
*.bin binary -text
*.h5 binary -text
*.weights binary -text
ml-weights/** binary -text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Archives
*.zip binary
*.tar binary
*.gz binary
